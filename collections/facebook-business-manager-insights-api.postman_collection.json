                {
                  "disabled": false,
                  "key": "time_range",
                  "value": "<string>",
                  "description": "JSON object specifying the date range with since and until fields in YYYY-MM-DD format."
                },
                {
                  "disabled": false,
                  "key": "breakdowns",
                  "value": "<string>",
                  "description": "Comma-separated list of breakdown dimensions such as age, gender, country, or placement."
